# ==============================================================================
# CiteBase — Production RAG-as-a-Service Configuration Template
# Multi-Tenant Document Intelligence API
# ==============================================================================

# Environment (development | production)
ENV=development
AUTH_ENABLED=true

# Database Configuration
# Local SQLite default:
DATABASE_URL=sqlite:///./data/app.db
# Production / Docker Compose PostgreSQL settings:
POSTGRES_USER=rag_admin
POSTGRES_PASSWORD=replace_with_a_secure_postgres_password
POSTGRES_DB=rag_service
# DATABASE_URL=postgresql://rag_admin:replace_with_a_secure_postgres_password@localhost:5432/rag_service

# Caching & Rate Limiting (Redis)
REDIS_URL=redis://localhost:6379/0
DEFAULT_RATE_LIMIT_RPM=60

# Initial Bootstrap Master API Key
# In production, must be a unique, high-entropy key (e.g. generated via python -c "import secrets; print('sk_live_' + secrets.token_urlsafe(32))")
BOOTSTRAP_API_KEY=sk_live_replace_with_your_own_master_key

# LLM & Search API Keys
GEMINI_API_KEY=your_gemini_api_key_here
# Configurable Gemini Model ID (e.g. gemini-2.5-flash, gemini-2.0-flash)
GEMINI_MODEL=gemini-2.5-flash

# Web Search
ENABLE_WEB_SEARCH=true
WEB_SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=
WEB_SEARCH_FALLBACK_THRESHOLD=0.35
WEB_SEARCH_MAX_RESULTS=4

# RAG & Embeddings
CHROMA_PATH=chroma_db
UPLOAD_DIR=data/uploaded_docs
ENABLE_RERANKER=true
INITIAL_RETRIEVAL_K=10
TOP_K_RESULTS=4
MIN_RELEVANCE_SCORE=0.20

# CORS
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000

# RAG Chunking
CHUNK_SIZE=600
CHUNK_OVERLAP=60
MIN_CHUNK_SIZE=20
INCLUDE_BREADCRUMBS=true

# Reranker
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_K=4

# Caching
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
